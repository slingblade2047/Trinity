// Windows version resource for Trinity.asi.
//
// A PE that carries proper VERSIONINFO (company / product / version) scores as
// far more legitimate to AV ML classifiers than a metadata-less binary. The
// numeric version is pulled from core/version.h so there is one source of truth.
//
// If you add an application icon later, drop it next to this file and uncomment
// the IDI_ICON1 line below.

#include <windows.h>
#include "core/version.h"
#include "core/provenance.h"

// IDI_ICON1 ICON "Trinity.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    TRINITY_VERSION_MAJOR,TRINITY_VERSION_MINOR,TRINITY_VERSION_PATCH,0
 PRODUCTVERSION TRINITY_VERSION_MAJOR,TRINITY_VERSION_MINOR,TRINITY_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"        // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "XeTrinityz / slingblade2047"
            VALUE "FileDescription",  "Trinity - Crimson Desert Compatibility Fork"
            VALUE "FileVersion",      TRINITY_VERSION
            VALUE "InternalName",     "Trinity.asi"
            VALUE "OriginalFilename", "Trinity.asi"
            VALUE "ProductName",      "Trinity Compatibility Fork"
            VALUE "ProductVersion",   TRINITY_VERSION
            VALUE "LegalCopyright",   "Copyright (C) 2026 XeTrinityz; compatibility work slingblade2047"
            VALUE "Comments",         "Source: " TRINITY_SOURCE_URL " | Upstream: " TRINITY_UPSTREAM_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
